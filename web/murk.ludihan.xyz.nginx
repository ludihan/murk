# /etc/nginx/sites-available/murk.ludihan.xyz  (a second server block next to your existing ludihan.xyz one)
# then:  ln -s ../sites-available/murk.ludihan.xyz /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
#        certbot --nginx -d murk.ludihan.xyz        (adds HTTPS; browsers need it for pointer lock and audio)
server {
    listen 80;
    server_name murk.ludihan.xyz;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

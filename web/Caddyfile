# Caddy gets and renews the HTTPS certificates for these names by itself.
murk.ludihan.com {
	root * /srv/current
	encode gzip
	file_server
	header Cache-Control "no-cache"
}

# Jenkins, over the shared "murk-web" network (ci/docker-compose.jenkins.yml). GitHub's push webhook comes in here too,
# at /github-webhook/. Jenkins asks for its own login; only build from this repo and keep sign-up off
jenkins.ludihan.com {
	reverse_proxy jenkins:8080
}

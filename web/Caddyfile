# Caddy gets and renews the HTTPS certificates for these names by itself.
murk.ludihan.com {
	root * /srv/current
	encode gzip
	file_server
	header Cache-Control "no-cache"
}

# Only GitHub's push webhook reaches Jenkins from outside (over the shared "murk-web" network). The Jenkins UI itself is
# private: open it through an SSH tunnel, ssh -L 8080:127.0.0.1:8080 you@server, then http://localhost:8080
jenkins.ludihan.com {
	handle /github-webhook/* {
		reverse_proxy jenkins:8080
	}
	handle {
		respond 404
	}
}
